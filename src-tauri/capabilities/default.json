{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the DeepSeek Harness main window: local assets plus the served loopback origin the SPA runs on, and the desktop commands the settings tab invokes (bare names resolve to the app ACL).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-desktop-get-state",
    "allow-desktop-set-setting",
    "allow-desktop-check-updates",
    "allow-desktop-open-release",
    "allow-desktop-reset-geometry",
    "allow-desktop-test-notification",
    "allow-desktop-is-directory",
    "allow-desktop-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-focus",
    "allow-desktop-update-now",
    "allow-desktop-install-info",
    "allow-desktop-list-dir",
    "allow-desktop-parent-dir",
    "allow-desktop-read-file",
    "allow-desktop-stat",
    "allow-desktop-hexdump",
    "allow-desktop-home-dir",
    "allow-desktop-write-file",
    "allow-desktop-create-dir",
    "allow-desktop-rename",
    "allow-desktop-delete",
    "allow-desktop-copy",
    "allow-desktop-move",
    "allow-desktop-open-path",
    "allow-desktop-search-names",
    "allow-desktop-clipboard-image"
  ]
}
